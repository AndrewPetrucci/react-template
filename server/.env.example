PORT=3001

# Option A: build URL from parts (recommended)
PG_USER=postgres
PG_PASSWORD=postgres
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=react_template

# Option B: or set the full URL (overrides Option A)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/react_template

# Auth (required for signup/login and email)
JWT_SECRET=your-secret-at-least-32-chars
JWT_EXPIRES_IN=7d
# In dev (Vite on 5173) use http://localhost:5173; in prod use your app URL (e.g. http://localhost:3001)
APP_URL=http://localhost:5173

# Email (verification + password reset). Without these, signup works but verification emails are skipped.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@example.com
